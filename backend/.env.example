# Application
APP_NAME=CodeImpact
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/codeimpact.db

# LLM Provider: "openai", "gemini", "ollama"
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Repository Storage
REPO_STORAGE_PATH=./data/repos
INDEX_STORAGE_PATH=./data/indexes
GRAPH_STORAGE_PATH=./data/graphs

# CORS
CORS_ORIGINS=["http://localhost:5173"]
