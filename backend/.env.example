# Application
APP_NAME=AI Code Explanation & Debugger Bot
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/coderag.db

# Ollama Configuration (Local ONLY)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=240.0

# ChromaDB & RAG Storage
CHROMA_PERSIST_DIR=./data/chroma_data
TOP_K_CHUNKS=5

# Repository Storage
REPO_STORAGE_PATH=./data/repos

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://localhost:3000"]
